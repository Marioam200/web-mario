---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import sobreMi from '../data/sobre-mi.json';

const bio = sobreMi.bio;
const facts = sobreMi.facts;
---

<Layout title="Sobre mí — Mario Álvarez" description="De campeón de España de madison a estudiante de Ciencia de Datos: la trayectoria de Mario Álvarez entre el ciclismo de élite y la analítica deportiva.">
	<PageHeader eyebrow="Sobre mí" title="Del velódromo a los datos" />

	<section class="bio">
		<div class="container bio-grid">
			<div class="bio-text reveal">
				{bio.map((p) => <p>{p}</p>)}
			</div>

			<div class="facts-grid reveal">
				{
					facts.map((fact) => (
						<div class="fact-card">
							<p class="fact-label">{fact.label}</p>
							<p class="fact-value">{fact.value}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.bio {
		padding-block: 1rem 6rem;
	}

	.bio-grid {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.bio-text p {
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--color-text-dim);
	}

	.bio-text p + p {
		margin-block-start: 1.15rem;
	}

	.facts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.fact-card {
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		padding: 1.1rem 1.3rem;
		transition: border-color var(--transition-fast);
	}

	.fact-card:hover {
		border-color: var(--color-blue);
	}

	.fact-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-blue);
		margin-block-end: 0.4rem;
	}

	.fact-value {
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 0.98rem;
	}

	@media (max-width: 860px) {
		.bio-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
