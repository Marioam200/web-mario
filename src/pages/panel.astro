---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panel — Mario Álvarez" description="Panel privado de gestión del sitio." noindex={true} panelPrivado={true}>
	<section class="panel">
		<div class="panel-container">
			<p id="panel-cargando" class="panel-cargando">Cargando…</p>

			<div id="panel-login" class="panel-login" hidden>
				<div class="login-card">
					<h1>Panel privado</h1>
					<form id="form-login">
						<label>
							Email
							<input type="email" id="login-email" autocomplete="username" required />
						</label>
						<label>
							Contraseña
							<input type="password" id="login-password" autocomplete="current-password" required />
						</label>
						<button type="submit" class="btn btn-primary">Entrar</button>
					</form>
					<p id="login-error" class="login-error"></p>
				</div>
			</div>

			<div id="panel-app" class="panel-app" hidden>
				<aside class="panel-sidebar">
					<div class="sidebar-brand">
						<img src="/mark-blanco.png" alt="" width="28" height="28" />
						<span>Panel</span>
					</div>

					<nav aria-label="Secciones del panel">
						<div class="sidebar-grupo">
							<button type="button" class="sidebar-titulo" aria-expanded="true">
								Añadir a la web
								<span class="chevron" aria-hidden="true">▾</span>
							</button>
							<div class="sidebar-grupo-links">
								<button type="button" class="sidebar-link is-active" data-tab="chat">Chat</button>
							</div>
						</div>

						<div class="sidebar-grupo">
							<button type="button" class="sidebar-titulo" aria-expanded="true">
								Usuarios
								<span class="chevron" aria-hidden="true">▾</span>
							</button>
							<div class="sidebar-grupo-links">
								<button type="button" class="sidebar-link" data-tab="usuarios">Gestionar</button>
							</div>
						</div>

						<div class="sidebar-grupo">
							<button type="button" class="sidebar-titulo" aria-expanded="true">
								Sistema
								<span class="chevron" aria-hidden="true">▾</span>
							</button>
							<div class="sidebar-grupo-links">
								<button type="button" class="sidebar-link" data-tab="logs">Registros</button>
								<button type="button" class="sidebar-link" data-tab="acerca-de">Acerca de</button>
								<button type="button" class="sidebar-link" data-tab="basedatos">Base de datos</button>
							</div>
						</div>
					</nav>

					<button type="button" id="btn-logout" class="btn-logout">Cerrar sesión</button>
				</aside>

				<main class="panel-main">
					<div class="panel-topbar">
						<button type="button" id="btn-toggle-sidebar" class="btn-toggle-sidebar" aria-label="Mostrar u ocultar el menú">☰</button>
						<span id="nombre-usuario" class="topbar-nombre"></span>
					</div>

					<section id="tab-chat" class="panel-tab" data-tab-panel="chat">
						<div class="panel-grid">
							<div class="chat-card reveal">
								<div id="mensajes" class="mensajes" aria-live="polite"></div>

								<form id="form-chat" class="form-chat">
									<textarea
										id="input-chat"
										rows="2"
										placeholder="Escribe con normalidad, como si me lo contaras a mí..."
										required
									></textarea>
									<button type="submit" class="btn btn-primary">Enviar</button>
								</form>
								<p id="estado-chat" class="estado-chat text-dim"></p>
							</div>

							<aside class="sidebar-panel reveal">
								<div class="card-propuesta">
									<h2>Cambio propuesto</h2>
									<div id="sin-propuesta" class="text-dim">Todavía no hay ningún cambio propuesto.</div>

									<div id="propuesta" class="propuesta" hidden>
										<p class="propuesta-archivo"><span id="propuesta-archivo-nombre"></span></p>
										<p id="propuesta-resumen" class="propuesta-resumen"></p>
										<details class="propuesta-json">
											<summary>Ver JSON completo</summary>
											<pre id="propuesta-contenido"></pre>
										</details>
										<div class="propuesta-acciones">
											<button id="btn-aprobar" type="button" class="btn btn-primary">Aprobar</button>
											<button id="btn-descartar" type="button" class="btn btn-ghost">Descartar</button>
										</div>
										<p id="estado-propuesta" class="estado-propuesta"></p>
									</div>
								</div>

								<div class="card-cv">
									<h2>Descargar CV</h2>
									<p class="text-dim">Generado al vuelo a partir de los datos actuales.</p>
									<div class="cv-controles">
										<select id="cv-idioma" aria-label="Idioma del CV">
											<option value="es">Español</option>
											<option value="en">English</option>
										</select>
										<button id="btn-cv" type="button" class="btn btn-ghost">Descargar PDF</button>
									</div>
								</div>
							</aside>
						</div>
					</section>

					<section id="tab-usuarios" class="panel-tab" data-tab-panel="usuarios" hidden>
						<div class="tab-header">
							<h1>Usuarios</h1>
							<button type="button" id="btn-nuevo-usuario" class="btn btn-primary">+ Nuevo usuario</button>
						</div>

						<table class="tabla-panel">
							<thead>
								<tr>
									<th>Nombre</th>
									<th>Correo electrónico</th>
									<th>Alta</th>
									<th>Acciones</th>
								</tr>
							</thead>
							<tbody id="usuarios-tbody"></tbody>
						</table>
					</section>

					<section id="tab-logs" class="panel-tab" data-tab-panel="logs" hidden>
						<h1>Registros</h1>
						<input type="search" id="logs-buscar" class="input-buscar" placeholder="Buscar en mensaje o contexto..." />
						<table class="tabla-panel">
							<thead>
								<tr>
									<th>Nivel</th>
									<th>Contexto</th>
									<th>Fecha</th>
									<th>Mensaje</th>
								</tr>
							</thead>
							<tbody id="logs-tbody"></tbody>
						</table>
					</section>

					<section id="tab-acerca-de" class="panel-tab" data-tab-panel="acerca-de" hidden>
						<h1>Acerca de</h1>
						<table class="tabla-panel tabla-clave-valor">
							<tbody id="acerca-de-tbody"></tbody>
						</table>
					</section>

					<section id="tab-basedatos" class="panel-tab" data-tab-panel="basedatos" hidden>
						<h1>Base de datos</h1>
						<div class="basedatos-grid">
							<div class="tablas-lista-wrap">
								<button type="button" class="tablas-lista-titulo sidebar-titulo" aria-expanded="false">
									Tablas
									<span class="chevron" aria-hidden="true">▾</span>
								</button>
								<div id="tablas-lista" class="tablas-lista" hidden></div>
							</div>

							<div class="sql-panel">
								<textarea id="sql-input" rows="4" placeholder="SELECT * FROM ..."></textarea>
								<button type="button" id="btn-ejecutar-sql" class="btn btn-primary">Ejecutar</button>
								<div id="sql-resultado"></div>
							</div>
						</div>
					</section>
				</main>
			</div>

			<div id="modal-nuevo-usuario" class="panel-modal" hidden>
				<form id="form-nuevo-usuario" class="panel-modal-card">
					<h2>Nuevo usuario</h2>

					<label>
						Nombre
						<input type="text" id="nuevo-usuario-nombre" required />
					</label>

					<label>
						Email
						<input type="email" id="nuevo-usuario-email" required />
					</label>

					<label>
						Contraseña
						<div class="password-row">
							<input type="text" id="nuevo-usuario-password" autocomplete="off" minlength="10" required />
							<button type="button" id="btn-generar-password">Generar aleatoria</button>
						</div>
					</label>

					<p id="nuevo-usuario-error" class="form-error"></p>

					<div class="form-acciones">
						<button type="submit" class="btn btn-primary">Crear</button>
						<button type="button" id="btn-cancelar-usuario" class="btn btn-ghost">Cancelar</button>
					</div>
				</form>
			</div>
		</div>
	</section>
</Layout>

<style>
	.panel {
		padding-block: 2rem 6rem;
	}

	.panel-container {
		width: 100%;
		max-width: none;
		padding-inline: 1rem 1.5rem;
	}

	.panel-cargando {
		color: var(--color-text-dim);
		font-size: 0.92rem;
	}

	/* --- Login --- */
	.panel-login:not([hidden]) {
		display: flex;
		justify-content: center;
		padding-block: 3rem;
	}

	.login-card {
		width: 100%;
		max-width: 360px;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 2rem;
	}

	.login-card h1 {
		font-size: 1.3rem;
		margin-block-end: 1.25rem;
	}

	.login-card form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.login-card label,
	.panel-modal-card label {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-size: 0.85rem;
		color: var(--color-text-dim);
	}

	.login-card input,
	.panel-modal-card input {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.92rem;
		padding: 0.6rem 0.8rem;
	}

	.login-card input:focus,
	.panel-modal-card input:focus,
	.input-buscar:focus {
		outline: none;
		border-color: var(--color-blue);
	}

	.login-card button[type='submit'] {
		margin-block-start: 0.5rem;
	}

	.login-error,
	.form-error {
		color: #f87171;
		font-size: 0.85rem;
		min-height: 1.2em;
		margin-block-start: 0.85rem;
	}

	/* --- Chat (sin cambios respecto al panel anterior) --- */
	.panel-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 2rem;
		align-items: start;
	}

	.chat-card {
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-height: 460px;
	}

	.mensajes {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		max-height: 55vh;
		overflow-y: auto;
		padding-inline-end: 0.25rem;
	}

	.burbuja {
		max-width: 80%;
		padding: 0.7rem 1rem;
		border-radius: 12px;
		font-size: 0.92rem;
		line-height: 1.5;
		white-space: pre-wrap;
	}

	.burbuja-usuario {
		align-self: flex-end;
		background: var(--color-blue);
		color: #06131c;
		border-bottom-right-radius: 3px;
	}

	.burbuja-modelo {
		align-self: flex-start;
		background: rgba(231, 236, 243, 0.06);
		border: 1px solid var(--color-border);
		color: var(--color-text);
		border-bottom-left-radius: 3px;
	}

	.form-chat {
		display: flex;
		gap: 0.75rem;
		align-items: flex-end;
		border-top: 1px solid var(--color-border);
		padding-block-start: 1rem;
	}

	.form-chat textarea {
		flex-grow: 1;
		resize: vertical;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.92rem;
		padding: 0.7rem 0.85rem;
	}

	.form-chat textarea:focus {
		outline: none;
		border-color: var(--color-blue);
	}

	.form-chat button {
		flex-shrink: 0;
	}

	.estado-chat {
		font-size: 0.82rem;
		min-height: 1.2em;
	}

	.sidebar-panel {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.card-propuesta,
	.card-cv {
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.4rem;
	}

	.card-propuesta h2,
	.card-cv h2 {
		font-size: 1.02rem;
		font-weight: 600;
		margin-block-end: 0.6rem;
	}

	.propuesta-archivo {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-blue);
		margin-block-end: 0.4rem;
	}

	.propuesta-resumen {
		font-size: 0.92rem;
		line-height: 1.5;
		margin-block-end: 0.85rem;
	}

	.propuesta-json {
		margin-block-end: 1rem;
	}

	.propuesta-json summary {
		cursor: pointer;
		font-size: 0.82rem;
		color: var(--color-text-dim);
	}

	.propuesta-json pre {
		margin-block-start: 0.6rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 0.75rem;
		font-size: 0.75rem;
		max-height: 260px;
		overflow: auto;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.propuesta-acciones {
		display: flex;
		gap: 0.75rem;
	}

	.estado-propuesta {
		font-size: 0.82rem;
		margin-block-start: 0.75rem;
		min-height: 1.2em;
	}

	.cv-controles {
		display: flex;
		gap: 0.75rem;
		margin-block-start: 1rem;
	}

	.cv-controles select {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.88rem;
		padding: 0.55rem 0.7rem;
	}

	/* --- Estructura del panel: sidebar + contenido --- */
	.panel-app:not([hidden]) {
		display: grid;
		grid-template-columns: 230px 1fr;
		gap: 2rem;
		align-items: start;
	}

	.panel-sidebar {
		position: sticky;
		top: 90px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2.5rem;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.5rem 1.25rem;
	}

	.sidebar-brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--color-text);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.95rem;
	}

	.panel-sidebar nav {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.sidebar-grupo {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.sidebar-titulo {
		display: flex;
		width: 100%;
		justify-content: space-between;
		align-items: center;
		background: none;
		border: none;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text-dim);
		padding-inline: 0.6rem;
		margin-block-end: 0.2rem;
	}

	.chevron {
		transition: transform var(--transition-fast);
	}

	.sidebar-titulo[aria-expanded='false'] .chevron {
		transform: rotate(-90deg);
	}

	.sidebar-grupo-links {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.sidebar-grupo-links[hidden] {
		display: none;
	}

	.sidebar-link {
		display: block;
		width: 100%;
		text-align: left;
		background: none;
		border: none;
		border-radius: 8px;
		color: var(--color-text-dim);
		font-family: inherit;
		font-size: 0.92rem;
		font-weight: 500;
		padding: 0.55rem 0.6rem;
		cursor: pointer;
		transition:
			background var(--transition-fast),
			color var(--transition-fast);
	}

	.sidebar-link:hover {
		color: var(--color-text);
		background: rgba(231, 236, 243, 0.06);
	}

	.sidebar-link.is-active {
		color: var(--color-blue);
		background: rgba(56, 189, 248, 0.1);
	}

	.btn-logout {
		background: none;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		color: var(--color-text-dim);
		font-family: inherit;
		font-size: 0.85rem;
		padding: 0.6rem;
		cursor: pointer;
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.btn-logout:hover {
		border-color: #f87171;
		color: #f87171;
	}

	.panel-main {
		min-width: 0;
	}

	.panel-topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-block: 0.5rem 1rem;
		margin-block-end: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.btn-toggle-sidebar {
		background: none;
		border: none;
		color: var(--color-text);
		font-size: 1.1rem;
		line-height: 1;
		cursor: pointer;
	}

	.topbar-nombre {
		color: var(--color-text-dim);
		font-size: 0.85rem;
	}

	.sidebar-oculto {
		display: none;
	}

	.panel-tab h1 {
		font-size: 1.4rem;
		margin-block-end: 1.5rem;
	}

	.tab-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-block-end: 1.5rem;
	}

	.tab-header h1 {
		margin-block-end: 0;
	}

	/* --- Tablas --- */
	.tabla-panel {
		width: 100%;
		border-collapse: collapse;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		overflow: hidden;
		font-size: 0.9rem;
	}

	.tabla-panel th,
	.tabla-panel td {
		text-align: left;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.tabla-panel th {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.8rem;
		color: var(--color-text-dim);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.tabla-panel tbody tr:last-child td {
		border-bottom: none;
	}

	.tabla-clave-valor td:first-child {
		color: var(--color-text-dim);
		width: 40%;
	}

	.etiqueta-nivel {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		text-transform: uppercase;
	}

	.etiqueta-nivel-info {
		color: var(--color-green);
		background: rgba(52, 211, 153, 0.12);
	}

	.etiqueta-nivel-error {
		color: #f87171;
		background: rgba(248, 113, 113, 0.12);
	}

	.input-buscar {
		display: block;
		width: 100%;
		max-width: 320px;
		margin-block-end: 1.25rem;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.9rem;
		padding: 0.6rem 0.85rem;
	}

	/* --- Base de datos --- */
	.basedatos-grid {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.5rem;
		align-items: start;
	}

	.tablas-lista {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.tablas-lista .btn-tabla-sql {
		display: block;
		width: 100%;
		text-align: left;
		background: none;
		border: none;
		border-radius: 8px;
		color: var(--color-text-dim);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		padding: 0.5rem 0.6rem;
		cursor: pointer;
		transition:
			background var(--transition-fast),
			color var(--transition-fast);
	}

	.tablas-lista .btn-tabla-sql:hover {
		color: var(--color-blue);
		background: rgba(56, 189, 248, 0.1);
	}

	.sql-panel {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	#sql-input {
		width: 100%;
		resize: vertical;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 0.88rem;
		padding: 0.7rem 0.85rem;
	}

	#sql-input:focus {
		outline: none;
		border-color: var(--color-blue);
	}

	#sql-resultado {
		overflow-x: auto;
	}

	/* --- Modal nuevo usuario --- */
	.panel-modal:not([hidden]) {
		position: fixed;
		inset: 0;
		z-index: 300;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(6, 9, 15, 0.7);
		padding: 1.5rem;
	}

	.panel-modal-card {
		width: 100%;
		max-width: 380px;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.panel-modal-card h2 {
		font-size: 1.1rem;
	}

	.password-row {
		display: flex;
		gap: 0.6rem;
	}

	.password-row input {
		flex-grow: 1;
		font-family: var(--font-mono);
	}

	.password-row button {
		flex-shrink: 0;
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		color: var(--color-text);
		font-size: 0.8rem;
		padding: 0 0.75rem;
		cursor: pointer;
		white-space: nowrap;
		transition: border-color var(--transition-fast);
	}

	.password-row button:hover {
		border-color: var(--color-blue);
	}

	.form-acciones {
		display: flex;
		gap: 0.75rem;
		margin-block-start: 0.25rem;
	}

	@media (max-width: 900px) {
		.panel-grid {
			grid-template-columns: 1fr;
		}

		.panel-app {
			grid-template-columns: 1fr;
		}

		.basedatos-grid {
			grid-template-columns: 1fr;
		}

		.panel-sidebar {
			position: static;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: center;
		}

		.panel-sidebar nav {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 1rem;
		}
	}
</style>

<style is:global>
	.tablas-lista .btn-tabla-sql {
		display: block;
		width: 100%;
		text-align: left;
		background: none;
		border: none;
		border-radius: 8px;
		color: var(--color-text-dim);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		padding: 0.5rem 0.6rem;
		cursor: pointer;
		transition:
			background var(--transition-fast),
			color var(--transition-fast);
	}

	.tablas-lista .btn-tabla-sql:hover {
		color: var(--color-blue);
		background: rgba(56, 189, 248, 0.1);
	}

	#sql-resultado table {
		width: 100%;
		border-collapse: collapse;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		overflow: hidden;
		font-size: 0.9rem;
	}

	#sql-resultado th,
	#sql-resultado td {
		text-align: left;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	#sql-resultado th {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.8rem;
		color: var(--color-text-dim);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
</style>

<script>
	type Rol = 'user' | 'model';
	interface Turno {
		role: Rol;
		text: string;
	}
	interface Propuesta {
		archivo: string;
		resumen: string;
		contenido: unknown;
	}

	// --- Elementos del cascarón (login / carga / app) ---
	const cargandoEl = document.getElementById('panel-cargando')!;
	const loginSeccionEl = document.getElementById('panel-login')!;
	const appEl = document.getElementById('panel-app')!;

	const formLoginEl = document.getElementById('form-login') as HTMLFormElement;
	const loginEmailEl = document.getElementById('login-email') as HTMLInputElement;
	const loginPasswordEl = document.getElementById('login-password') as HTMLInputElement;
	const loginErrorEl = document.getElementById('login-error')!;

	const btnLogoutEl = document.getElementById('btn-logout') as HTMLButtonElement;

	const btnToggleSidebarEl = document.getElementById('btn-toggle-sidebar');
	const sidebarEl = document.querySelector('.panel-sidebar');
	btnToggleSidebarEl?.addEventListener('click', () => {
		sidebarEl?.classList.toggle('sidebar-oculto');
	});

	const sidebarNavEl = document.querySelector('.panel-sidebar nav');
	sidebarNavEl?.addEventListener('click', (evento) => {
		const boton = (evento.target as HTMLElement).closest('.sidebar-titulo') as HTMLButtonElement | null;
		if (!boton) return;

		const expandido = boton.getAttribute('aria-expanded') === 'true';
		boton.setAttribute('aria-expanded', String(!expandido));
		const links = boton.nextElementSibling as HTMLElement | null;
		if (links) links.hidden = expandido;
	});

	const btnTablasListaTituloEl = document.querySelector('.tablas-lista-titulo');
	btnTablasListaTituloEl?.addEventListener('click', () => {
		const expandido = btnTablasListaTituloEl.getAttribute('aria-expanded') === 'true';
		btnTablasListaTituloEl.setAttribute('aria-expanded', String(!expandido));
		tablasListaEl.hidden = expandido;
	});

	function escaparHtml(texto: string): string {
		const div = document.createElement('div');
		div.textContent = texto;
		return div.innerHTML;
	}

	// ================= Chat (igual que antes, solo se movió de sitio) =================
	const mensajesEl = document.getElementById('mensajes')!;
	const formEl = document.getElementById('form-chat') as HTMLFormElement;
	const inputEl = document.getElementById('input-chat') as HTMLTextAreaElement;
	const estadoChatEl = document.getElementById('estado-chat')!;

	const sinPropuestaEl = document.getElementById('sin-propuesta')!;
	const propuestaEl = document.getElementById('propuesta')!;
	const propuestaArchivoEl = document.getElementById('propuesta-archivo-nombre')!;
	const propuestaResumenEl = document.getElementById('propuesta-resumen')!;
	const propuestaContenidoEl = document.getElementById('propuesta-contenido')!;
	const btnAprobarEl = document.getElementById('btn-aprobar') as HTMLButtonElement;
	const btnDescartarEl = document.getElementById('btn-descartar') as HTMLButtonElement;
	const estadoPropuestaEl = document.getElementById('estado-propuesta')!;

	const cvIdiomaEl = document.getElementById('cv-idioma') as HTMLSelectElement;
	const btnCvEl = document.getElementById('btn-cv') as HTMLButtonElement;

	const history: Turno[] = [];
	let propuestaActual: Propuesta | null = null;

	function agregarBurbuja(role: Rol, texto: string) {
		const burbuja = document.createElement('div');
		burbuja.className = `burbuja ${role === 'user' ? 'burbuja-usuario' : 'burbuja-modelo'}`;
		burbuja.textContent = texto;
		mensajesEl.appendChild(burbuja);
		mensajesEl.scrollTop = mensajesEl.scrollHeight;
	}

	function mostrarPropuesta(propuesta: Propuesta) {
		propuestaActual = propuesta;
		sinPropuestaEl.hidden = true;
		propuestaEl.hidden = false;
		propuestaArchivoEl.textContent = `src/data/${propuesta.archivo}`;
		propuestaResumenEl.textContent = propuesta.resumen;
		propuestaContenidoEl.textContent = JSON.stringify(propuesta.contenido, null, 2);
		estadoPropuestaEl.textContent = '';
	}

	function limpiarPropuesta() {
		propuestaActual = null;
		propuestaEl.hidden = true;
		sinPropuestaEl.hidden = false;
		estadoPropuestaEl.textContent = '';
	}

	formEl.addEventListener('submit', async (evento) => {
		evento.preventDefault();
		const texto = inputEl.value.trim();
		if (!texto) return;

		agregarBurbuja('user', texto);
		history.push({ role: 'user', text: texto });
		inputEl.value = '';
		inputEl.disabled = true;
		estadoChatEl.textContent = 'Pensando...';

		try {
			const respuesta = await fetch('/api/chat', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ history }),
			});
			const datos = await respuesta.json();

			if (!datos.ok) {
				estadoChatEl.textContent = datos.error || 'Ha fallado el chat.';
				history.pop();
				return;
			}

			agregarBurbuja('model', datos.reply);
			history.push({ role: 'model', text: datos.reply });
			estadoChatEl.textContent = '';

			if (datos.proposal) {
				mostrarPropuesta(datos.proposal);
			}
		} catch (error) {
			estadoChatEl.textContent = 'No se pudo contactar con el servidor.';
			history.pop();
		} finally {
			inputEl.disabled = false;
			inputEl.focus();
		}
	});

	btnDescartarEl.addEventListener('click', () => {
		limpiarPropuesta();
	});

	btnAprobarEl.addEventListener('click', async () => {
		if (!propuestaActual) return;
		btnAprobarEl.disabled = true;
		btnDescartarEl.disabled = true;
		estadoPropuestaEl.textContent = 'Guardando en panel-test...';

		try {
			const respuesta = await fetch('/api/guardar', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ archivo: propuestaActual.archivo, contenido: propuestaActual.contenido }),
			});
			const datos = await respuesta.json();

			if (!datos.ok) {
				estadoPropuestaEl.textContent = datos.error || 'No se pudo guardar.';
				return;
			}

			estadoPropuestaEl.textContent = `Guardado en ${datos.rama}.`;
			setTimeout(limpiarPropuesta, 1500);
		} catch (error) {
			estadoPropuestaEl.textContent = 'No se pudo contactar con el servidor.';
		} finally {
			btnAprobarEl.disabled = false;
			btnDescartarEl.disabled = false;
		}
	});

	btnCvEl.addEventListener('click', () => {
		const lang = cvIdiomaEl.value;
		window.open(`/api/cv-pdf?lang=${lang}&rama=panel-test`, '_blank');
	});

	// ================= Usuarios =================
	const usuariosTbodyEl = document.getElementById('usuarios-tbody')!;
	const btnNuevoUsuarioEl = document.getElementById('btn-nuevo-usuario') as HTMLButtonElement;
	const modalNuevoUsuarioEl = document.getElementById('modal-nuevo-usuario')!;
	const formNuevoUsuarioEl = document.getElementById('form-nuevo-usuario') as HTMLFormElement;
	const nuevoUsuarioNombreEl = document.getElementById('nuevo-usuario-nombre') as HTMLInputElement;
	const nuevoUsuarioEmailEl = document.getElementById('nuevo-usuario-email') as HTMLInputElement;
	const nuevoUsuarioPasswordEl = document.getElementById('nuevo-usuario-password') as HTMLInputElement;
	const btnGenerarPasswordEl = document.getElementById('btn-generar-password') as HTMLButtonElement;
	const nuevoUsuarioErrorEl = document.getElementById('nuevo-usuario-error')!;
	const btnCancelarUsuarioEl = document.getElementById('btn-cancelar-usuario') as HTMLButtonElement;

	interface Usuario {
		id: number;
		nombre: string;
		email: string;
		creadoEn: string;
	}

	function generarPasswordAleatoria(longitud = 16): string {
		const alfabeto = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%&*';
		const valores = crypto.getRandomValues(new Uint32Array(longitud));
		return Array.from(valores, (v) => alfabeto[v % alfabeto.length]).join('');
	}

	async function cargarUsuarios() {
		usuariosTbodyEl.innerHTML = '<tr><td colspan="4">Cargando…</td></tr>';
		try {
			const respuesta = await fetch('/api/panel/usuarios');
			const datos = await respuesta.json();

			if (!respuesta.ok) {
				usuariosTbodyEl.innerHTML = `<tr><td colspan="4">${escaparHtml(datos.error || 'No se pudo cargar.')}</td></tr>`;
				return;
			}

			const usuarios: Usuario[] = datos.usuarios;
			if (usuarios.length === 0) {
				usuariosTbodyEl.innerHTML = '<tr><td colspan="4">Todavía no hay usuarios.</td></tr>';
				return;
			}

			usuariosTbodyEl.innerHTML = usuarios
				.map(
					(u) => `
						<tr>
							<td>${escaparHtml(u.nombre)}</td>
							<td>${escaparHtml(u.email)}</td>
							<td>${escaparHtml(u.creadoEn)}</td>
							<td>
								<button type="button" class="btn-eliminar-usuario" data-id="${u.id}" data-nombre="${escaparHtml(u.email)}">
									Eliminar
								</button>
							</td>
						</tr>
					`,
				)
				.join('');
		} catch (error) {
			usuariosTbodyEl.innerHTML = '<tr><td colspan="4">No se pudo contactar con el servidor.</td></tr>';
		}
	}

	usuariosTbodyEl.addEventListener('click', async (evento) => {
		const boton = (evento.target as HTMLElement).closest('.btn-eliminar-usuario') as HTMLButtonElement | null;
		if (!boton) return;

		const id = boton.dataset.id;
		const email = boton.dataset.nombre;
		if (!confirm(`¿Seguro que quieres eliminar el acceso de ${email}? No se puede deshacer.`)) return;

		boton.disabled = true;
		try {
			const respuesta = await fetch(`/api/panel/usuarios/${id}`, { method: 'DELETE' });
			if (!respuesta.ok) {
				const datos = await respuesta.json().catch(() => ({}));
				alert(datos.error || 'No se pudo eliminar el usuario.');
				boton.disabled = false;
				return;
			}
			cargarUsuarios();
		} catch (error) {
			alert('No se pudo contactar con el servidor.');
			boton.disabled = false;
		}
	});

	function abrirModalUsuario() {
		formNuevoUsuarioEl.reset();
		nuevoUsuarioErrorEl.textContent = '';
		modalNuevoUsuarioEl.hidden = false;
		nuevoUsuarioNombreEl.focus();
	}

	function cerrarModalUsuario() {
		modalNuevoUsuarioEl.hidden = true;
	}

	btnNuevoUsuarioEl.addEventListener('click', abrirModalUsuario);
	btnCancelarUsuarioEl.addEventListener('click', cerrarModalUsuario);

	btnGenerarPasswordEl.addEventListener('click', () => {
		nuevoUsuarioPasswordEl.value = generarPasswordAleatoria(16);
	});

	formNuevoUsuarioEl.addEventListener('submit', async (evento) => {
		evento.preventDefault();
		nuevoUsuarioErrorEl.textContent = '';

		const nombre = nuevoUsuarioNombreEl.value.trim();
		const email = nuevoUsuarioEmailEl.value.trim();
		const password = nuevoUsuarioPasswordEl.value;

		try {
			const respuesta = await fetch('/api/panel/usuarios', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ nombre, email, password }),
			});
			const datos = await respuesta.json();

			if (!respuesta.ok) {
				nuevoUsuarioErrorEl.textContent = datos.error || 'No se pudo crear el usuario.';
				return;
			}

			cerrarModalUsuario();
			cargarUsuarios();
		} catch (error) {
			nuevoUsuarioErrorEl.textContent = 'No se pudo contactar con el servidor.';
		}
	});

	// ================= Registros (logs) =================
	const logsTbodyEl = document.getElementById('logs-tbody')!;
	const logsBuscarEl = document.getElementById('logs-buscar') as HTMLInputElement;
	let logsDebounceId: ReturnType<typeof setTimeout> | undefined;

	interface LogSistema {
		nivel: string;
		contexto: string;
		mensaje: string;
		creadoEn: string;
	}

	async function cargarLogs(buscar = '') {
		logsTbodyEl.innerHTML = '<tr><td colspan="4">Cargando…</td></tr>';
		try {
			const url = buscar ? `/api/panel/logs?buscar=${encodeURIComponent(buscar)}` : '/api/panel/logs';
			const respuesta = await fetch(url);
			const datos = await respuesta.json();

			if (!respuesta.ok) {
				logsTbodyEl.innerHTML = `<tr><td colspan="4">${escaparHtml(datos.error || 'No se pudo cargar.')}</td></tr>`;
				return;
			}

			const logs: LogSistema[] = datos.logs;
			if (logs.length === 0) {
				logsTbodyEl.innerHTML = '<tr><td colspan="4">Sin resultados.</td></tr>';
				return;
			}

			logsTbodyEl.innerHTML = logs
				.map(
					(l) => `
						<tr>
							<td><span class="etiqueta-nivel etiqueta-nivel-${escaparHtml(l.nivel)}">${escaparHtml(l.nivel)}</span></td>
							<td>${escaparHtml(l.contexto)}</td>
							<td>${escaparHtml(l.creadoEn)}</td>
							<td>${escaparHtml(l.mensaje)}</td>
						</tr>
					`,
				)
				.join('');
		} catch (error) {
			logsTbodyEl.innerHTML = '<tr><td colspan="4">No se pudo contactar con el servidor.</td></tr>';
		}
	}

	logsBuscarEl.addEventListener('input', () => {
		clearTimeout(logsDebounceId);
		logsDebounceId = setTimeout(() => cargarLogs(logsBuscarEl.value.trim()), 300);
	});

	// ================= Acerca de =================
	const acercaDeTbodyEl = document.getElementById('acerca-de-tbody')!;

	const ETIQUETAS_ACERCA_DE: Record<string, string> = {
		nombre: 'Nombre',
		framework: 'Framework',
		entorno: 'Entorno',
		url: 'URL',
		baseDatos: 'Base de datos',
		repo: 'Repositorio',
		commit: 'Commit',
		rama: 'Rama',
	};

	async function cargarAcercaDe() {
		acercaDeTbodyEl.innerHTML = '<tr><td colspan="2">Cargando…</td></tr>';
		try {
			const respuesta = await fetch('/api/panel/acerca-de');
			const datos = await respuesta.json();

			if (!respuesta.ok) {
				acercaDeTbodyEl.innerHTML = `<tr><td colspan="2">${escaparHtml(datos.error || 'No se pudo cargar.')}</td></tr>`;
				return;
			}

			acercaDeTbodyEl.innerHTML = Object.entries(ETIQUETAS_ACERCA_DE)
				.map(([clave, etiqueta]) => {
					const valor = datos[clave];
					return `<tr><td>${escaparHtml(etiqueta)}</td><td>${valor != null ? escaparHtml(String(valor)) : '—'}</td></tr>`;
				})
				.join('');
		} catch (error) {
			acercaDeTbodyEl.innerHTML = '<tr><td colspan="2">No se pudo contactar con el servidor.</td></tr>';
		}
	}

	// ================= Base de datos =================
	const tablasListaEl = document.getElementById('tablas-lista')!;
	const sqlInputEl = document.getElementById('sql-input') as HTMLTextAreaElement;
	const btnEjecutarSqlEl = document.getElementById('btn-ejecutar-sql') as HTMLButtonElement;
	const sqlResultadoEl = document.getElementById('sql-resultado')!;

	interface ResultadoSQL {
		columnas: string[];
		filas: Record<string, unknown>[];
		meta: { cambios: number; filas: number; duracionMs: number | null };
	}

	const PALABRAS_CONFIRMACION_SQL = ['delete', 'update', 'drop', 'alter', 'truncate'];

	async function cargarTablasSQL() {
		tablasListaEl.innerHTML = 'Cargando…';
		try {
			const respuesta = await fetch('/api/panel/db/tablas');
			const datos = await respuesta.json();

			if (!respuesta.ok) {
				tablasListaEl.innerHTML = escaparHtml(datos.error || 'No se pudo cargar.');
				return;
			}

			const tablas: string[] = datos.tablas;
			if (tablas.length === 0) {
				tablasListaEl.innerHTML = 'No hay tablas.';
				return;
			}

			tablasListaEl.innerHTML = tablas
				.map(
					(tabla) =>
						`<button type="button" class="btn-tabla-sql" data-tabla="${escaparHtml(tabla)}">${escaparHtml(tabla)}</button>`,
				)
				.join('');
		} catch (error) {
			tablasListaEl.innerHTML = 'No se pudo contactar con el servidor.';
		}
	}

	function pintarResultadoSQL(datos: ResultadoSQL) {
		if (datos.columnas.length === 0) {
			sqlResultadoEl.innerHTML = `<p class="text-dim">${datos.meta.cambios} filas afectadas</p>`;
			return;
		}

		const cabecera = datos.columnas.map((columna) => `<th>${escaparHtml(columna)}</th>`).join('');
		const filas = datos.filas
			.map(
				(fila) =>
					`<tr>${datos.columnas.map((columna) => `<td>${escaparHtml(String(fila[columna] ?? ''))}</td>`).join('')}</tr>`,
			)
			.join('');

		sqlResultadoEl.innerHTML = `
			<table class="tabla-panel">
				<thead><tr>${cabecera}</tr></thead>
				<tbody>${filas}</tbody>
			</table>
		`;
	}

	async function ejecutarSQL(sql: string) {
		const sqlNormalizado = sql.toLowerCase().trimStart();
		if (PALABRAS_CONFIRMACION_SQL.some((palabra) => sqlNormalizado.startsWith(palabra))) {
			if (!confirm(`Vas a ejecutar:\n\n${sql}\n\n¿Seguro?`)) return;
		}

		btnEjecutarSqlEl.disabled = true;
		try {
			const respuesta = await fetch('/api/panel/db/consulta', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ sql }),
			});
			const datos = await respuesta.json();

			if (!respuesta.ok) {
				sqlResultadoEl.innerHTML = `<p class="form-error">${escaparHtml(datos.error || 'No se pudo ejecutar.')}</p>`;
				return;
			}

			pintarResultadoSQL(datos);
		} catch (error) {
			sqlResultadoEl.innerHTML = '<p class="form-error">No se pudo contactar con el servidor.</p>';
		} finally {
			btnEjecutarSqlEl.disabled = false;
		}
	}

	btnEjecutarSqlEl.addEventListener('click', () => {
		ejecutarSQL(sqlInputEl.value);
	});

	tablasListaEl.addEventListener('click', (evento) => {
		const boton = (evento.target as HTMLElement).closest('.btn-tabla-sql') as HTMLButtonElement | null;
		if (!boton) return;
		const tabla = boton.dataset.tabla;
		sqlInputEl.value = `SELECT * FROM ${tabla} LIMIT 100;`;
		ejecutarSQL(sqlInputEl.value);
	});

	// ================= Navegación por pestañas =================
	const sidebarLinks = Array.from(document.querySelectorAll<HTMLButtonElement>('.sidebar-link'));
	const paneles = Array.from(document.querySelectorAll<HTMLElement>('.panel-tab'));

	const cargasPorPestana: Record<string, () => void> = {
		usuarios: cargarUsuarios,
		logs: () => cargarLogs(logsBuscarEl.value.trim()),
		'acerca-de': cargarAcercaDe,
		basedatos: cargarTablasSQL,
	};

	sidebarLinks.forEach((link) => {
		link.addEventListener('click', () => {
			const pestana = link.dataset.tab!;
			sidebarLinks.forEach((l) => l.classList.toggle('is-active', l === link));
			paneles.forEach((panel) => {
				panel.hidden = panel.dataset.tabPanel !== pestana;
			});
			cargasPorPestana[pestana]?.();
		});
	});

	// ================= Sesión: login / logout / comprobación inicial =================
	formLoginEl.addEventListener('submit', async (evento) => {
		evento.preventDefault();
		loginErrorEl.textContent = '';

		const email = loginEmailEl.value.trim();
		const password = loginPasswordEl.value;

		try {
			const respuesta = await fetch('/api/panel/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, password }),
			});

			if (!respuesta.ok) {
				const datos = await respuesta.json().catch(() => ({}));
				loginErrorEl.textContent = datos.error || 'No se pudo iniciar sesión.';
				return;
			}

			location.reload();
		} catch (error) {
			loginErrorEl.textContent = 'No se pudo contactar con el servidor.';
		}
	});

	btnLogoutEl.addEventListener('click', async () => {
		btnLogoutEl.disabled = true;
		try {
			await fetch('/api/panel/logout', { method: 'POST' });
		} finally {
			location.reload();
		}
	});

	(async () => {
		try {
			const respuesta = await fetch('/api/panel/me');
			const datos = await respuesta.json();

			cargandoEl.hidden = true;

			if (datos.autenticado) {
				appEl.hidden = false;
				const nombreUsuarioEl = document.getElementById('nombre-usuario');
				if (nombreUsuarioEl) nombreUsuarioEl.textContent = datos.nombre;
			} else {
				loginSeccionEl.hidden = false;
				loginEmailEl.focus();
			}
		} catch (error) {
			cargandoEl.hidden = true;
			loginSeccionEl.hidden = false;
		}
	})();
</script>
