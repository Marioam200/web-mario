---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const datosItems = [
	{
		title: 'SIME TELECOM — Prácticas de Ciencia de Datos',
		meta: 'Ingeniería de Datos · Benidorm · 2026',
		paragraphs: [
			'SIME desarrolla software de gestión (reservas, facturación, informes, pedidos de restauración) que sirve a cientos de clientes desde un sistema central, sobre una base de datos de +580 tablas interconectadas y +100 millones de registros. El crecimiento había obligado a repartir clientes en varias bases para aliviar la carga y las quejas de lentitud.',
			'Mi trabajo: analizar esas bases y, mediante optimización de consultas e índices, diseñar la unificación de todos los datos en una única base eficiente sin escalar apenas el hardware (RAM/CPU). Mejora ya desarrollada, en fase de validación sobre servidor de pruebas.',
		],
	},
	{
		title: 'Proyectos con el equipo Cofidis (World Tour)',
		meta: 'Python · Verano 2025',
		paragraphs: [
			'Proyecto propio que realicé como prueba para acceder al análisis de datos en el ciclismo profesional:',
		],
		list: [
			'Analizador de dificultad UCI: mediante web scraping del ranking UCI, sitúa a los corredores del equipo y estima el nivel de dificultad para sumar puntos UCI según la plantilla.',
			'Predictor de perfil de carrera: anticipa las características de cada carrera y le asigna una nota de dificultad para planificar objetivos y estrategia.',
		],
	},
	{
		title: 'Proyectos académicos y personales',
		meta: 'Análisis, visualización y machine learning',
		paragraphs: ['Trabajos propios de análisis de datos, visualización y machine learning.'],
		link: { href: '/proyectos', label: 'Ver proyectos' },
	},
];

const deporteItems = [
	{
		title: 'Competición',
		paragraphs: [
			'Campeón de España de madison (18 años); Mundial y Europeo de pista con la Selección Española (6º en ambos); deportista de élite; ciclista de pista federado, en activo.',
		],
	},
	{
		title: 'Dirección deportiva',
		paragraphs: [
			'Director Deportivo Nivel I y II (RFEC); formación y seguimiento de ciclistas de base (14–18) junto a mi padre; auxiliar con la Selección de la Comunidad Valenciana en competiciones (2026).',
		],
	},
	{
		title: 'Quiromasaje y staff técnico',
		meta: 'Verano 2025',
		paragraphs: [
			'Quiromasajista titulado; masajista de ciclistas profesionales; staff con la Selección de la Comunidad Valenciana, con un equipo continental filipino y con ciclistas a título particular en Benidorm.',
		],
	},
];
---

<Layout title="Experiencia — Mario Álvarez" description="Dos mundos, un mismo lenguaje: el rendimiento. Experiencia de Mario Álvarez en datos e ingeniería, y en ciclismo de élite.">
	<PageHeader eyebrow="Experiencia" title="Dos mundos, un mismo lenguaje: el rendimiento" />

	<section class="experiencia">
		<div class="container experiencia-columns">
			<div class="column reveal">
				<h2>Datos &amp; Tecnología</h2>
				<div class="timeline">
					{
						datosItems.map((item) => (
							<article class="timeline-item">
								<h3>{item.title}</h3>
								{item.meta && <p class="timeline-meta">{item.meta}</p>}
								{item.paragraphs.map((p) => <p class="text-dim">{p}</p>)}
								{item.list && (
									<ul class="timeline-list">
										{item.list.map((entry) => (
											<li class="text-dim">{entry}</li>
										))}
									</ul>
								)}
								{item.link && (
									<a href={item.link.href} class="timeline-link">
										{item.link.label} →
									</a>
								)}
							</article>
						))
					}
				</div>
			</div>

			<div class="column reveal">
				<h2>Deporte de élite</h2>
				<div class="timeline">
					{
						deporteItems.map((item) => (
							<article class="timeline-item">
								<h3>{item.title}</h3>
								{item.meta && <p class="timeline-meta">{item.meta}</p>}
								{item.paragraphs.map((p) => <p class="text-dim">{p}</p>)}
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.experiencia {
		padding-block: 1rem 6rem;
	}

	.experiencia-columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.column h2 {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 600;
		margin-block-end: 1.5rem;
		padding-block-end: 0.85rem;
		border-bottom: 1px solid var(--color-border);
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.timeline-item {
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		padding: 1.4rem;
		transition: border-color var(--transition-fast);
	}

	.timeline-item:hover {
		border-color: var(--color-green);
	}

	.timeline-item h3 {
		font-size: 1.02rem;
		font-weight: 600;
	}

	.timeline-meta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-green);
		margin-block-start: 0.35rem;
	}

	.timeline-item p.text-dim {
		font-size: 0.94rem;
		line-height: 1.6;
		margin-block-start: 0.75rem;
	}

	.timeline-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-block-start: 0.75rem;
	}

	.timeline-list li {
		font-size: 0.94rem;
		line-height: 1.6;
		padding-inline-start: 1rem;
		position: relative;
	}

	.timeline-list li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: 0.55em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-blue);
	}

	.timeline-link {
		display: inline-block;
		margin-block-start: 0.9rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-blue);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.timeline-link:hover {
		color: var(--color-green);
	}

	@media (max-width: 860px) {
		.experiencia-columns {
			grid-template-columns: 1fr;
			gap: 3.5rem;
		}
	}
</style>
