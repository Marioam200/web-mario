---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'Mario Álvarez — Científico de datos especializado en deporte',
	description = 'Mario Álvarez, científico de datos en Valencia especializado en analítica deportiva. Data · Sport · Progress.',
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-card.png?v=1', Astro.site);
const socialImageAlt = 'Mario Álvarez — científico de datos especializado en analítica deportiva';

const navLinks = [
	{ href: '/sobre-mi', label: 'Sobre mí' },
	{ href: '/proyectos', label: 'Proyectos' },
	{ href: '/experiencia', label: 'Experiencia' },
	{ href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href;

const socialLinks = [
	{ href: 'https://www.linkedin.com/in/mario-alvarez-martinez/', label: 'LinkedIn' },
	{ href: 'https://github.com/Marioam200', label: 'GitHub' },
	{ href: 'https://www.instagram.com/mario.a.m_200/', label: 'Instagram' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png?v=3" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Mario Álvarez" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={socialImageAlt} />

		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Mario Álvarez",
				"jobTitle": "Científico de datos",
				"description": "Científico de datos especializado en analítica deportiva, con experiencia dentro del ciclismo profesional.",
				"url": "https://marioalvarez.me",
				"image": "https://marioalvarez.me/mario.jpg",
				"alumniOf": {
					"@type": "CollegeOrUniversity",
					"name": "Universitat Politècnica de València"
				},
				"knowsAbout": ["Ciencia de datos", "Analítica deportiva", "Ciclismo", "Machine Learning", "Python", "SQL", "R", "Power BI"],
				"sameAs": [
					"https://www.linkedin.com/in/mario-alvarez-martinez/",
					"https://github.com/Marioam200",
					"https://www.instagram.com/mario.a.m_200/"
				]
			}
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header id="site-header">
			<div class="container nav-inner">
				<a href="/" class="brand">
					<img src="/mark-blanco.png" alt="" width="36" height="36" class="brand-mark" />
					<span class="brand-name">Mario Álvarez</span>
				</a>

				<nav id="site-nav" aria-label="Navegación principal">
					<ul>
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="nav-actions">
					<a href="/contacto" class="btn btn-primary">Contacto</a>
					<button id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-nav">
						<span></span>
						<span></span>
						<span></span>
					</button>
				</div>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer id="contacto">
			<div class="container footer-inner">
				<div class="footer-brand">
					<img src="/mark-blanco.png" alt="" width="30" height="30" class="footer-mark" />
					<div>
						<p class="footer-name">Mario Álvarez</p>
						<p class="text-dim">Data · Sport · Progress</p>
					</div>
				</div>

				<ul class="footer-social" aria-label="Redes sociales">
					{
						socialLinks.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="noopener noreferrer">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div class="container">
				<p class="footer-copy text-dim">© {new Date().getFullYear()} Mario Álvarez. Valencia.</p>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById('nav-toggle');
			const nav = document.getElementById('site-nav');

			toggle?.addEventListener('click', () => {
				const isOpen = nav?.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
			});

			nav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					nav.classList.remove('is-open');
					toggle?.setAttribute('aria-expanded', 'false');
				});
			});

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealEls = document.querySelectorAll('.reveal');

			if (prefersReducedMotion || !('IntersectionObserver' in window)) {
				revealEls.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
				);

				revealEls.forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>

<style>
	#site-header {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 100;
		background: rgba(6, 9, 15, 0.6);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--color-border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 0.85rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--color-text);
	}

	.brand-mark {
		border-radius: 8px;
	}

	#site-nav ul {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		list-style: none;
	}

	#site-nav a {
		text-decoration: none;
		color: var(--color-text-dim);
		font-size: 0.92rem;
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	#site-nav a:hover {
		color: var(--color-text);
	}

	#site-nav a[aria-current='page'] {
		color: var(--color-text);
		position: relative;
	}

	#site-nav a[aria-current='page']::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		inset-block-end: -6px;
		height: 2px;
		border-radius: 2px;
		background: linear-gradient(90deg, var(--color-blue), var(--color-green));
	}

	#site-nav ul li:last-child {
		display: none;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	#nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 38px;
		height: 38px;
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		cursor: pointer;
	}

	#nav-toggle span {
		display: block;
		height: 2px;
		margin-inline: 8px;
		background: var(--color-text);
		border-radius: 2px;
		transition: transform var(--transition-fast), opacity var(--transition-fast);
	}

	main {
		padding-block-start: 68px;
	}

	footer {
		border-top: 1px solid var(--color-border);
		padding-block: 2.5rem 1.5rem;
		margin-block-start: 4rem;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block-end: 1.5rem;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.footer-mark {
		flex-shrink: 0;
	}

	.footer-name {
		font-family: var(--font-heading);
		font-weight: 600;
		margin-block-end: 0.2rem;
	}

	.footer-social {
		display: flex;
		gap: 1.5rem;
		list-style: none;
	}

	.footer-social a {
		text-decoration: none;
		color: var(--color-text-dim);
		font-size: 0.9rem;
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	.footer-social a:hover {
		color: var(--color-green);
	}

	.footer-copy {
		font-size: 0.82rem;
		border-top: 1px solid var(--color-border);
		padding-block-start: 1.25rem;
	}

	@media (max-width: 820px) {
		#site-nav {
			position: fixed;
			inset-block-start: 68px;
			inset-inline: 0;
			background: rgba(6, 9, 15, 0.97);
			backdrop-filter: blur(14px);
			border-bottom: 1px solid var(--color-border);
			transform: translateY(-8px);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition:
				opacity var(--transition-fast),
				transform var(--transition-fast),
				visibility var(--transition-fast);
		}

		#site-nav.is-open {
			opacity: 1;
			transform: translateY(0);
			visibility: visible;
			pointer-events: auto;
		}

		#site-nav ul {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			padding: 1rem 1.5rem 1.5rem;
		}

		#site-nav ul li {
			width: 100%;
			border-bottom: 1px solid var(--color-border);
		}

		#site-nav ul li:last-child {
			display: block;
		}

		#site-nav a {
			display: block;
			padding: 0.9rem 0;
		}

		.nav-actions .btn-primary {
			display: none;
		}

		#nav-toggle {
			display: flex;
		}
	}

	@media (max-width: 520px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
