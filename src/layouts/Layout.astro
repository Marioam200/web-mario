---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { type Locale, localizedPath, alternatePath, strings } from '../lib/i18n';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	lang?: Locale;
	panelPrivado?: boolean;
}

const {
	title = 'Mario Álvarez — Científico de datos especializado en deporte',
	description = 'Mario Álvarez, científico de datos en Valencia especializado en analítica deportiva. Data · Sport · Progress.',
	noindex = false,
	lang = 'es',
	panelPrivado = false,
} = Astro.props;

const t = strings[lang];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-card.png?v=1', Astro.site);
const socialImageAlt = 'Mario Álvarez — científico de datos especializado en analítica deportiva';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const otherLocalePath = alternatePath(currentPath);
const pathES = lang === 'es' ? currentPath : otherLocalePath;
const pathEN = lang === 'en' ? currentPath : otherLocalePath;

const navLinks = [
	{ href: localizedPath('/sobre-mi', lang), label: t.nav.sobreMi },
	{ href: localizedPath('/proyectos', lang), label: t.nav.proyectos },
	{ href: localizedPath('/experiencia', lang), label: t.nav.experiencia },
	{ href: localizedPath('/contacto', lang), label: t.nav.contacto },
];

const isActive = (href: string) => currentPath === href;

const socialLinks = [
	{ href: 'https://www.linkedin.com/in/mario-alvarez-martinez/', label: 'LinkedIn' },
	{ href: 'https://github.com/Marioam200', label: 'GitHub' },
	{ href: 'https://www.instagram.com/mario.a.m_200/', label: 'Instagram' },
	{ href: 'tel:+34656867231', label: lang === 'en' ? 'Phone' : 'Teléfono' },
];

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Mario Álvarez',
	jobTitle: 'Científico de datos',
	description:
		'Científico de datos especializado en analítica deportiva, con experiencia dentro del ciclismo profesional.',
	url: 'https://marioalvarez.me',
	image: 'https://marioalvarez.me/mario.jpg',
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Universitat Politècnica de València',
	},
	knowsAbout: ['Ciencia de datos', 'Analítica deportiva', 'Ciclismo', 'Machine Learning', 'Python', 'SQL', 'R', 'Power BI'],
	sameAs: [
		'https://www.linkedin.com/in/mario-alvarez-martinez/',
		'https://github.com/Marioam200',
		'https://www.instagram.com/mario.a.m_200/',
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png?v=3" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es" href={new URL(pathES, Astro.site)} />
		<link rel="alternate" hreflang="en" href={new URL(pathEN, Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL(pathES, Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Mario Álvarez" />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
		<meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialImageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={socialImageAlt} />

		{lang === 'es' && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		{!panelPrivado && (
			<header id="site-header">
				<div class="container nav-inner">
					<a href={localizedPath('/', lang)} class="brand">
						<img src="/mark-blanco.png" alt="" width="36" height="36" class="brand-mark" />
						<span class="brand-name">Mario Álvarez</span>
					</a>

					<nav id="site-nav" aria-label={t.nav.ariaMain}>
						<ul>
							{
								navLinks.map((link) => (
									<li>
										<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>

					<div class="nav-actions">
						<div class="lang-switch" aria-label={t.langSwitch.label}>
							<a href={pathES} aria-current={lang === 'es' ? 'true' : undefined}>
								{t.langSwitch.es}
							</a>
							<span aria-hidden="true">·</span>
							<a href={pathEN} aria-current={lang === 'en' ? 'true' : undefined}>
								{t.langSwitch.en}
							</a>
						</div>
						<a href={localizedPath('/contacto', lang)} class="btn btn-primary">
							{t.nav.contacto}
						</a>
						<button id="nav-toggle" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="site-nav">
							<span></span>
							<span></span>
							<span></span>
						</button>
					</div>
				</div>
			</header>
		)}

		<main>
			<slot />
		</main>

		{!panelPrivado && (
			<footer id="contacto">
				<div class="container footer-inner">
					<div class="footer-brand">
						<img src="/mark-blanco.png" alt="" width="30" height="30" class="footer-mark" />
						<div>
							<p class="footer-name">Mario Álvarez</p>
							<p class="text-dim">{t.footer.tagline}</p>
						</div>
					</div>

					<div class="footer-legal-links">
						<a href={localizedPath('/politica-de-privacidad', lang)} class="footer-cookie-btn">{t.legal.privacidad}</a>
						<a href={localizedPath('/politica-de-cookies', lang)} class="footer-cookie-btn">{t.legal.cookies}</a>
						<button type="button" id="cookie-config-btn" class="footer-cookie-btn">{t.cookies.configurar}</button>
					</div>

					<div class="footer-social">
						<SocialLinks links={socialLinks} ariaLabel={t.footer.ariaSocial} />
					</div>
				</div>
				<div class="container">
					<p class="footer-copy text-dim">{t.footer.copy(new Date().getFullYear())}</p>
				</div>
			</footer>
		)}

		{!panelPrivado && <CookieBanner lang={lang} />}

		<script>
			const toggle = document.getElementById('nav-toggle');
			const nav = document.getElementById('site-nav');

			toggle?.addEventListener('click', () => {
				const isOpen = nav?.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
			});

			nav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					nav.classList.remove('is-open');
					toggle?.setAttribute('aria-expanded', 'false');
				});
			});

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealEls = document.querySelectorAll('.reveal');

			if (prefersReducedMotion || !('IntersectionObserver' in window)) {
				revealEls.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
				);

				revealEls.forEach((el) => observer.observe(el));
			}
		</script>

		<script>
			import '../scripts/tracking.js';
		</script>
	</body>
</html>

<style>
	#site-header {
		position: fixed;
		inset-block-start: 0;
		inset-inline: 0;
		z-index: 100;
		background: rgba(6, 9, 15, 0.6);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--color-border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 0.85rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--color-text);
	}

	.brand-mark {
		border-radius: 8px;
	}

	#site-nav ul {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		list-style: none;
	}

	#site-nav a {
		text-decoration: none;
		color: var(--color-text-dim);
		font-size: 0.92rem;
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	#site-nav a:hover {
		color: var(--color-text);
	}

	#site-nav a[aria-current='page'] {
		color: var(--color-text);
		position: relative;
	}

	#site-nav a[aria-current='page']::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		inset-block-end: -6px;
		height: 2px;
		border-radius: 2px;
		background: linear-gradient(90deg, var(--color-blue), var(--color-green));
	}

	#site-nav ul li:last-child {
		display: none;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-text-dim);
	}

	.lang-switch a {
		text-decoration: none;
		color: var(--color-text-dim);
		transition: color var(--transition-fast);
	}

	.lang-switch a[aria-current='true'] {
		color: var(--color-blue);
		font-weight: 600;
	}

	.lang-switch a:hover {
		color: var(--color-text);
	}

	#nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 38px;
		height: 38px;
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		cursor: pointer;
	}

	#nav-toggle span {
		display: block;
		height: 2px;
		margin-inline: 8px;
		background: var(--color-text);
		border-radius: 2px;
		transition: transform var(--transition-fast), opacity var(--transition-fast);
	}

	main {
		padding-block-start: 68px;
	}

	footer {
		border-top: 1px solid var(--color-border);
		padding-block: 2.5rem 1.5rem;
		margin-block-start: 4rem;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.5rem;
		padding-block-end: 1.5rem;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.footer-mark {
		flex-shrink: 0;
	}

	.footer-legal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem;
	}

	.footer-social {
		justify-self: end;
	}

	.footer-cookie-btn {
		background: none;
		border: none;
		padding: 0;
		font: inherit;
		font-size: 0.9rem;
		color: var(--color-text-dim);
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color var(--transition-fast);
	}

	.footer-cookie-btn:hover {
		color: var(--color-blue);
	}

	.footer-name {
		font-family: var(--font-heading);
		font-weight: 600;
		margin-block-end: 0.2rem;
	}

	.footer-copy {
		font-size: 0.82rem;
		border-top: 1px solid var(--color-border);
		padding-block-start: 1.25rem;
	}

	@media (max-width: 820px) {
		#site-nav {
			position: fixed;
			inset-block-start: 68px;
			inset-inline: 0;
			background: rgba(6, 9, 15, 0.97);
			backdrop-filter: blur(14px);
			border-bottom: 1px solid var(--color-border);
			transform: translateY(-8px);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition:
				opacity var(--transition-fast),
				transform var(--transition-fast),
				visibility var(--transition-fast);
		}

		#site-nav.is-open {
			opacity: 1;
			transform: translateY(0);
			visibility: visible;
			pointer-events: auto;
		}

		#site-nav ul {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			padding: 1rem 1.5rem 1.5rem;
		}

		#site-nav ul li {
			width: 100%;
			border-bottom: 1px solid var(--color-border);
		}

		#site-nav ul li:last-child {
			display: block;
		}

		#site-nav a {
			display: block;
			padding: 0.9rem 0;
		}

		.nav-actions .btn-primary {
			display: none;
		}

		#nav-toggle {
			display: flex;
		}
	}

	@media (max-width: 520px) {
		.footer-inner {
			grid-template-columns: 1fr;
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
