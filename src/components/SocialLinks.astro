---
import { siGithub, siInstagram } from 'simple-icons';
import externalLinkIcon from 'lucide-static/icons/external-link.svg?raw';
import phoneIcon from 'lucide-static/icons/phone.svg?raw';

interface Props {
	links: { href: string; label: string }[];
	size?: number;
	ariaLabel?: string;
}

// simple-icons retiró el logo de LinkedIn del paquete (aviso legal de LinkedIn/Microsoft).
// Para esa red usamos en su lugar un trazado de un icono libre (svgrepo.com, licencia libre),
// con su propio viewBox porque no comparte las proporciones 24x24 de los iconos de simple-icons.
const MARCAS: Record<string, { path: string; viewBox?: string } | undefined> = {
	GitHub: siGithub,
	Instagram: siInstagram,
	LinkedIn: {
		path: 'M347.445,0H34.555C15.471,0,0,15.471,0,34.555v312.889C0,366.529,15.471,382,34.555,382h312.889C366.529,382,382,366.529,382,347.444V34.555C382,15.471,366.529,0,347.445,0z M118.207,329.844c0,5.554-4.502,10.056-10.056,10.056H65.345c-5.554,0-10.056-4.502-10.056-10.056V150.403c0-5.554,4.502-10.056,10.056-10.056h42.806c5.554,0,10.056,4.502,10.056,10.056V329.844z M86.748,123.432c-22.459,0-40.666-18.207-40.666-40.666S64.289,42.1,86.748,42.1s40.666,18.207,40.666,40.666S109.208,123.432,86.748,123.432z M341.91,330.654c0,5.106-4.14,9.246-9.246,9.246H286.73c-5.106,0-9.246-4.14-9.246-9.246v-84.168c0-12.556,3.683-55.021-32.813-55.021c-28.309,0-34.051,29.066-35.204,42.11v97.079c0,5.106-4.139,9.246-9.246,9.246h-44.426c-5.106,0-9.246-4.14-9.246-9.246V149.593c0-5.106,4.14-9.246,9.246-9.246h44.426c5.106,0,9.246,4.14,9.246,9.246v15.655c10.497-15.753,26.097-27.912,59.312-27.912c73.552,0,73.131,68.716,73.131,106.472L341.91,330.654L341.91,330.654z',
		viewBox: '0 0 382 382',
	},
};

const { links, size = 21, ariaLabel = 'Redes sociales' } = Astro.props;
---

<ul class="social-links" aria-label={ariaLabel}>
	{
		links.map((link) => {
			const esTelefono = link.href.startsWith('tel:');
			const esExterno = link.href.startsWith('http');
			const marca = MARCAS[link.label];
			return (
				<li>
					<a
						href={link.href}
						target={esExterno ? '_blank' : undefined}
						rel={esExterno ? 'noopener noreferrer' : undefined}
						aria-label={link.label}
					>
						{esTelefono ? (
							<Fragment set:html={phoneIcon} />
						) : marca ? (
							<svg viewBox={marca.viewBox ?? '0 0 24 24'} width={size} height={size} fill="currentColor" aria-hidden="true">
								<path d={marca.path} />
							</svg>
						) : (
							<Fragment set:html={externalLinkIcon} />
						)}
					</a>
				</li>
			);
		})
	}
</ul>

<style>
	.social-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		list-style: none;
	}

	.social-links a {
		display: inline-flex;
		color: var(--color-text-dim);
		transition: color var(--transition-fast);
	}

	.social-links a:hover {
		color: var(--color-blue);
	}

	.social-links :global(svg) {
		width: 21px;
		height: 21px;
		stroke: currentColor;
	}
</style>
