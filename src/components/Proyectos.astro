---
import { obtenerDescripciones } from '../lib/descripciones';

interface Repo {
	id: number;
	name: string;
	description: string | null;
	html_url: string;
	language: string | null;
	updated_at: string;
	fork: boolean;
}

const GITHUB_USER = 'Marioam200';

let repos: Repo[] = [];

try {
	const response = await fetch(
		`https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=100`,
		{
			headers: {
				Accept: 'application/vnd.github+json',
			},
		},
	);

	if (response.ok) {
		const data: Repo[] = await response.json();
		repos = data
			.filter((repo) => repo.name !== GITHUB_USER)
			.sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());
	} else {
		console.error(`GitHub API respondió con estado ${response.status}`);
	}
} catch (error) {
	console.error('Error al obtener los repositorios de GitHub:', error);
}

const languages = [...new Set(repos.map((repo) => repo.language).filter(Boolean))].sort() as string[];

let descripciones: Record<string, string> = {};
try {
	descripciones = await obtenerDescripciones(repos);
} catch (error) {
	console.error('Error al generar las descripciones con IA:', error);
}
---

<section id="proyectos">
	<div class="container">
		<div class="section-header reveal">
			<p class="eyebrow">Trabajo</p>
			<h2>Proyectos</h2>
			<p class="text-dim">Una selección automática de mis repositorios públicos en GitHub.</p>
		</div>

		{
			languages.length > 0 && (
				<div class="especializaciones reveal">
					<h3>Especializaciones</h3>
					<ul class="tags">
						{languages.map((lang) => (
							<li class="tag">{lang}</li>
						))}
					</ul>
				</div>
			)
		}

		{
			repos.length > 0 ? (
				<div class="grid">
					{repos.map((repo, i) => (
						<article class="card reveal" style={`transition-delay: ${Math.min(i, 6) * 0.06}s`}>
							<div class="card-header">
								<h3>{repo.name}</h3>
								{repo.language && <span class="language">{repo.language}</span>}
							</div>
							<p class="description text-dim">
								{descripciones[repo.name] || repo.description || 'Proyecto de análisis y ciencia de datos.'}
							</p>
							<a class="button" href={repo.html_url} target="_blank" rel="noopener noreferrer">
								Ver en GitHub
							</a>
						</article>
					))}
				</div>
			) : (
				<p class="empty text-dim">No se pudieron cargar los repositorios en este momento.</p>
			)
		}
	</div>
</section>

<style>
	#proyectos {
		padding-block: 2rem 6rem;
	}

	.section-header {
		max-width: 62ch;
		margin-block-end: 2.5rem;
	}

	.section-header h2 {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		margin-block: 0.75rem 0.5rem;
	}

	.especializaciones {
		margin-block-end: 3rem;
	}

	.especializaciones h3 {
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 600;
		margin-block-end: 1rem;
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.tag {
		font-family: var(--font-mono);
		background: rgba(56, 189, 248, 0.1);
		border: 1px solid rgba(56, 189, 248, 0.35);
		color: var(--color-blue);
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		padding: 1.5rem;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: var(--color-green);
	}

	.card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.card-header h3 {
		font-size: 1.1rem;
		word-break: break-word;
	}

	.language {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--color-green);
		background: rgba(52, 211, 153, 0.12);
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		white-space: nowrap;
	}

	.description {
		flex-grow: 1;
		font-size: 0.92rem;
		line-height: 1.5;
		margin: 0 0 1.25rem;
	}

	.button {
		align-self: flex-start;
		color: var(--color-text);
		background: transparent;
		border: 1px solid rgba(56, 189, 248, 0.4);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		padding: 0.5rem 1.05rem;
		border-radius: 8px;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.button:hover {
		border-color: var(--color-blue);
		background: rgba(56, 189, 248, 0.08);
	}

	.empty {
		text-align: center;
	}
</style>
